{
  "name": "@xyeena/island",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Privacy-first Windows Island companion for Xyeena workflows, media controls and explicitly enabled clipboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "doctor": "node scripts/doctor.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "check": "npm test && npm run build && npm run release:audit"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@xyeena/recap": "*",
    "@xyeena/xyn": "*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "license": "MIT"
}
