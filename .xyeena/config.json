{
  "schemaVersion": 3,
  "profile": ".xyeena/profile.md",
  "adapterMode": "auto",
  "adapters": [],
  "targetBranch": "main",
  "protectedBranches": [
    "main",
    "master"
  ],
  "risk": {
    "default": "MEDIUM",
    "rules": [
      {
        "level": "HIGH",
        "patterns": [
          "**/auth/**",
          "**/security/**",
          "**/migrations/**",
          ".github/workflows/**",
          "**/infrastructure/**",
          "**/infra/**"
        ]
      },
      {
        "level": "MEDIUM",
        "patterns": [
          "src/**",
          "app/**",
          "pages/**",
          "lib/**",
          "package.json",
          "pyproject.toml",
          "requirements.txt",
          "*lock*"
        ]
      },
      {
        "level": "LOW",
        "patterns": [
          "**/*.md",
          "**/*.mdx",
          "docs/**",
          "README*",
          "CHANGELOG*",
          "LICENSE*"
        ]
      }
    ]
  },
  "verification": {
    "LOW": [
      "lint"
    ],
    "MEDIUM": [
      "lint",
      "typecheck",
      "test",
      "build"
    ],
    "HIGH": [
      "lint",
      "typecheck",
      "test",
      "build"
    ],
    "CRITICAL": [
      "lint",
      "typecheck",
      "test",
      "build"
    ]
  },
  "scan": {
    "maxTextFileBytes": 1000000,
    "blockedPaths": [
      "**/.superpowers/**",
      "**/.codex/**",
      "**/prompt-dump/**",
      "**/session-dump/**"
    ],
    "blockedTrackedEnvNames": [
      ".env",
      ".env.local",
      ".env.production",
      ".env.development"
    ],
    "allowedEnvNames": [
      ".env.example",
      ".env.sample",
      ".env.template"
    ],
    "blockedContentPatterns": [
      {
        "name": "OpenAI-style secret",
        "regex": "\\bsk-[A-Za-z0-9_-]{20,}\\b"
      },
      {
        "name": "GitHub classic token",
        "regex": "\\bgh[pousr]_[A-Za-z0-9]{20,}\\b"
      },
      {
        "name": "AWS access key",
        "regex": "\\bAKIA[0-9A-Z]{16}\\b"
      },
      {
        "name": "Private key material",
        "regex": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
      },
      {
        "name": "AI attribution residue",
        "regex": "(?:Generated by (?:ChatGPT|Codex)|Co-authored-by:\\s*(?:ChatGPT|Codex))"
      }
    ],
    "allowPaths": [
      ".xyeena/**",
      "xyeena-harness.config.json",
      "xyeena-harness.config.example.json",
      "harness/**",
      "integration/**",
      "adapters/**",
      "profiles/**",
      "templates/**",
      "RESEARCH_NOTES.md"
    ]
  },
  "contracts": [],
  "remoteGate": {
    "blockProtectedBranchPush": true,
    "requireCleanIndex": true,
    "evidenceMaxAgeMinutes": 60
  }
}
